{
  "name": "kinema-root",
  "license": "MIT",
  "version": "0.0.1-alpha.4",
  "build": 6,
  "private": true,
  "description": "Kinema - Personal media server in the spirit of Plex",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,web\" -c \"cyan,magenta\" \"pnpm run dev:backend\" \"pnpm run dev:web\"",
    "dev:backend": "node scripts/dev-backend.mjs",
    "start:backend": "cargo run --manifest-path backend/Cargo.toml",
    "dev:web": "pnpm --filter @kinema/web dev",
    "build": "pnpm run build:web && pnpm run build:backend",
    "build:web": "pnpm --filter @kinema/web build",
    "build:web:dev": "pnpm --filter @kinema/web build:dev",
    "build:web:prod": "pnpm --filter @kinema/web build:prod",
    "build:backend": "cargo build --release --manifest-path backend/Cargo.toml",
    "android:gateway": "bash scripts/android-gateway.sh",
    "android:dev": "bash scripts/android-dev.sh",
    "android:build:dev": "(cd apps/android && ./gradlew :app:assembleDevDebug)",
    "android:build:prod": "(cd apps/android && ./gradlew :app:assembleProdRelease)",
    "android:test": "(cd apps/android && ./gradlew :core:testDebugUnitTest)",
    "dev:desktop": "pnpm --filter @kinema/desktop dev",
    "dev:desktop:prod": "pnpm --filter @kinema/desktop dev:prod",
    "build:desktop": "pnpm --filter @kinema/desktop build:prod",
    "build:desktop:dev": "pnpm --filter @kinema/desktop build:dev",
    "build:desktop:prod": "pnpm --filter @kinema/desktop build:prod",
    "test:desktop": "pnpm --filter @kinema/desktop test",
    "lint": "pnpm --filter @kinema/web lint && cargo clippy -- -D warnings",
    "test": "cargo test && pnpm --filter @kinema/web test && pnpm --filter @kinema/desktop test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
