    <string name="trust_title">ಈ ಸರ್ವರ್ ಅನ್ನು ನಂಬುವುದೇ?</string>
    <string name="trust_body">%1$s ತನ್ನದೇ ಆದ ಭದ್ರತಾ ಪ್ರಮಾಣಪತ್ರವನ್ನು ರಚಿಸಿದೆ. ನೀವು ಅದನ್ನು ನಂಬುವ ಮೊದಲು ಈ ಕೋಡ್ ವೆಬ್‌ನಲ್ಲಿ Kinema ದಲ್ಲಿ Settings › Network ಅಡಿಯಲ್ಲಿ ಇರುವ ಕೋಡ್‌ಗೆ ಹೊಂದಿಕೆಯಾಗುತ್ತದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ.</string>
    <string name="trust_accept">ನಂಬು</string>

    <string name="unreachable_title">ಸರ್ವರ್ ತಲುಪಲು ಸಾಧ್ಯವಿಲ್ಲ</string>
    <string name="unreachable_body">%1$s ನಲ್ಲಿರುವ Kinema ತನ್ನ ಹೋಮ್ ಅಥವಾ ಸಾರ್ವಜನಿಕ ವಿಳಾಸದಲ್ಲಿ ಉತ್ತರಿಸಲಿಲ್ಲ.</string>

    <string name="forget_title">ಬೇರೆ ಸರ್ವರ್ ಬಳಸುವುದೇ?</string>
    <string name="forget_body">ಈ ಫೋನ್ ಸರ್ವರ್, ಅದರ ವಿಳಾಸಗಳು ಮತ್ತು ಅದರ ಪ್ರಮಾಣಪತ್ರವನ್ನು ಮರೆತುಬಿಡುತ್ತದೆ. ನಿಮ್ಮ ವೀಕ್ಷಣಾ ಇತಿಹಾಸವು ಸರ್ವರ್‌ನಲ್ಲಿಯೇ ಇರುತ್ತದೆ.</string>
    <string name="forget_action">ಸರ್ವರ್ ಮರೆತುಬಿಡಿ</string>

