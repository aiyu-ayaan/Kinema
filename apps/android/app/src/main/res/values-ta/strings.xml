    <string name="error_offline">சேவையகத்தை அணுக முடியவில்லை. அது இயங்குவதையும் இந்தத் தொலைபேசி அதே பிணையத்தில் உள்ளதையும் உறுதிசெய்யவும், அல்லது பொது முகவரியை அமைக்கவும்.</string>
    <string name="error_untrusted">சேவையகத்தின் சான்றிதழ் நீங்கள் அங்கீகரித்தது அல்ல. அதைச் சரிபார்க்க மீண்டும் இணைக்கவும்.</string>

    <!-- Connect -->
    <string name="connect_title">Kinema</string>
    <string name="connect_subtitle">உங்கள் திரைப்படங்களும் தொடர்களும், உங்கள் சொந்த சேவையகத்திலிருந்து.</string>
    <string name="connect_found">இந்தப் பிணையத்தில்</string>
    <string name="connect_rescan">மீண்டும் தேடு</string>
    <string name="connect_scanning">சேவையகங்களைத் தேடுகிறது…</string>
    <string name="connect_none">எந்தச் சேவையகமும் பதிலளிக்கவில்லை. Kinema இயங்குவதையும் இந்தத் தொலைபேசி அதே Wi-Fi-இல் உள்ளதையும் உறுதிசெய்யவும், அல்லது கீழே அதன் முகவரியை உள்ளிடவும்.</string>
    <string name="connect_this_computer">இந்தக் கணினி · %1$s</string>
    <string name="connect_manual">முகவரியை உள்ளிடவும்</string>
    <string name="connect_address">சேவையக முகவரி</string>
    <string name="connect_address_hint">வலையில் உள்ள Kinema-இல் அமைப்புகள் › பிணையம் என்பதன் கீழ் காட்டப்படும்</string>
    <string name="connect_invalid">192.168.1.10:3000 அல்லது media.example.com போன்ற முகவரியை உள்ளிடவும்.</string>
    <string name="connect_action">இணை</string>
    <string name="connect_change_server">வேறு சேவையகத்தைப் பயன்படுத்து</string>

    <string name="trust_title">இந்தச் சேவையகத்தை நம்பலாமா?</string>
    <string name="trust_body">%1$s தனது சொந்த பாதுகாப்புச் சான்றிதழை உருவாக்கியுள்ளது. நம்புவதற்கு முன், இந்தக் குறியீடு வலையில் உள்ள Kinema-இல் அமைப்புகள் › பிணையத்தில் உள்ள குறியீட்டுடன் பொருந்துகிறதா எனச் சரிபார்க்கவும்.</string>
    <string name="trust_accept">நம்பு</string>

    <string name="unreachable_title">சேவையகத்தை அணுக முடியவில்லை</string>
    <string name="unreachable_body">%1$s-இல் உள்ள Kinema அதன் முகப்பு அல்லது பொது முகவரியில் பதிலளிக்கவில்லை.</string>

    <string name="forget_title">வேறு சேவையகத்தைப் பயன்படுத்தவா?</string>
    <string name="forget_body">இந்தத் தொலைபேசி சேவையகம், அதன் முகவரிகள் மற்றும் அதன் சான்றிதழை மறந்துவிடும். உங்கள் பார்வை வரலாறு சேவையகத்திலேயே இருக்கும்.</string>
    <string name="forget_action">சேவையகத்தை மற</string>

