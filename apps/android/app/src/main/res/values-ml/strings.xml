    <string name="trust_title">ഈ സെർവറിനെ വിശ്വസിക്കണോ?</string>
    <string name="trust_body">%1$s സ്വന്തമായി സുരക്ഷാ സർട്ടിഫിക്കറ്റ് നിർമ്മിച്ചു. വിശ്വസിക്കുന്നതിന് മുമ്പ് ഈ കോഡ് വെബിലെ Kinema-യിൽ Settings › Network-ന് കീഴിലുള്ളതുമായി പൊരുത്തപ്പെടുന്നുണ്ടോ എന്ന് പരിശോധിക്കുക.</string>
    <string name="trust_accept">വിശ്വസിക്കുക</string>

    <string name="unreachable_title">സെർവറിലേക്ക് എത്താനാകുന്നില്ല</string>
    <string name="unreachable_body">%1$s-ലുള്ള Kinema അതിന്റെ ഹോം അല്ലെങ്കിൽ പൊതു വിലാസത്തിൽ പ്രതികരിച്ചില്ല.</string>

    <string name="forget_title">മറ്റൊരു സെർവർ ഉപയോഗിക്കണോ?</string>
    <string name="forget_body">ഈ ഫോൺ സെർവറും അതിന്റെ വിലാസങ്ങളും സർട്ടിഫിക്കറ്റും മറക്കും. നിങ്ങളുടെ കാണൽ ചരിത്രം സെർവറിൽ തന്നെ തുടരും.</string>
    <string name="forget_action">സെർവർ മറക്കുക</string>

