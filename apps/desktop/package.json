{
  "name": "@kinema/desktop",
  "productName": "Kinema",
  "desktopName": "kinema.desktop",
  "version": "0.0.1-alpha.10",
  "private": true,
  "description": "Kinema personal media server, desktop app",
  "author": "Kinema Team <ayaan35200@gmail.com>",
  "homepage": "https://github.com/aiyu-ayaan/Kinema",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "dev": "KINEMA_FLAVOR=dev electron . --no-sandbox",
    "dev:prod": "KINEMA_FLAVOR=prod electron . --no-sandbox",
    "test": "node --test tests/*.test.js",
    "build": "pnpm run build:prod",
    "fetch:mpv": "node ../../scripts/fetch-mpv.mjs",
    "build:prod": "node ../../scripts/fetch-mpv.mjs && electron-builder --linux --config electron-builder.prod.json",
    "build:dev": "node ../../scripts/fetch-mpv.mjs && electron-builder --linux --config electron-builder.dev.json",
    "build:win": "node ../../scripts/fetch-mpv.mjs windows-x64 && electron-builder --win --config electron-builder.prod.json"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
